import subprocess
import os

def extract_audio(video_path: str, output_audio_path: str):
    command = [
        "ffmpeg", "-y", "-i", video_path,
        "-vn", "-acodec", "libmp3lame", "-q:a", "2",
        output_audio_path
    ]
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        raise Exception(f"FFmpeg Error: {result.stderr.decode('utf-8')}")

def merge_audio_video(video_path: str, audio_path: str, output_video_path: str):
    # Replaces the original audio with the new audio, mapping video stream 0 and audio stream 1
    command = [
        "ffmpeg", "-y", 
        "-i", video_path, 
        "-i", audio_path, 
        "-c:v", "copy", 
        "-c:a", "aac", 
        "-map", "0:v:0", 
        "-map", "1:a:0", 
        output_video_path
    ]
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        raise Exception(f"FFmpeg Error: {result.stderr.decode('utf-8')}")
